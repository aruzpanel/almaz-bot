# BotFather bergan token
BOT_TOKEN=

# Asosiy admin Telegram ID (raqam)
ADMIN_ID=

# Telegram webhook so'rovlarini tasdiqlash uchun uzun tasodifiy satr.
# setWebhook chaqiruvidagi secret_token bilan bir xil bo'lishi shart.
WEBHOOK_SECRET=

# Bot username, @ belgisisiz (referral havolalari uchun)
BOT_USERNAME=

# SQLite fayli. Bo'sh qoldiring: standart <loyiha>/data/bot.sqlite ishlatiladi.
# Qiymat bersangiz, faqat TO'LIQ yo'l yozing (masalan /var/www/bot/data/bot.sqlite): nisbiy yo'l
# PHP ishlayotgan papkaga qarab hisoblanadi va baza public/ ichida paydo bo'lib qolishi mumkin.
DB_PATH=

# Ruxsat etilgan telefon kodlari, vergul bilan
ALLOWED_PHONE_PREFIXES=998,996
